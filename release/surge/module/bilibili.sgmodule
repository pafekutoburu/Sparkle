#!name=哔哩哔哩增强（老国际版兼容）
#!desc=基于 Sparkle；恢复请求优化开关，弹幕仅追加提示、缓存与解压有界；使用 JSC 资料净化、独立轻量 WebView 播放器资源脚本，保留原压缩及完成状态；新增 PiliPlus 分类空降助手，保留旧实现。
#!category=Enhancement
#!arguments=动态最常访问:auto,创作中心:0,过滤置顶评论广告:1,优化评论区加载:#,资料净化:bilibili.protobuf.response,空降助手:bilibili.sponsor,空降助手（旧）:#,空降资源替换:1,空降助手策略:DIRECT,空降助手服务器:https://www.bsbsb.top,最短片段时长:0,赞助片段:auto,自我推广:manual,品牌合作:show,三连提醒:manual,精彩时刻:show,开场动画:manual,片尾:manual,回顾概要:manual,填充内容:manual,离题闲聊:manual,非音乐部分:manual,屏蔽P2P:DEST-PORT,日志等级:4
#!arguments-desc=动态最常访问: auto/show/hide\n创作中心: 0 隐藏，1 显示\n过滤置顶评论广告: 0 关闭，1 开启\n优化评论区加载: 默认 #（关闭）；改为 bilibili.request 可启用旧请求接管\n资料净化: 默认开启；# 关闭；关闭后保留 JSON 等功能，但取消热门/详情/评论的 Protobuf 净化；播放器资源由新旧空降助手及空降资源替换开关控制\n空降助手: 新实现；# 关闭；需允许弹幕显示；不依赖资料净化开关\n空降助手（旧）: 保留原实现；默认 #；改为 bilibili.airborne 启用，新旧请选择其一\n空降资源替换: 1 开启（默认）；0 原样放行；2 保留原资源但执行响应重建，仅用于隔离协议/资源延迟；0/2 保留片段查询/提示，自动跳过与撤销可能不可用\n空降助手策略: DIRECT 或已有策略名称；同时用于第三方片段查询\n空降助手服务器: HTTPS 根地址；默认与 PiliPlus 相同\n最短片段时长: 秒，短于此值仅提示\n11 类片段策略: auto 自动跳过 / manual 点按跳过 / show 仅提示 / off 禁用；mute/full 仅提示；poi 支持 manual 点按跳转\n自动跳过和点按跳过复用原 Chronos 播放器资源；关闭弹幕时不保证触发；尚不支持跳过一次\n屏蔽P2P: # 关闭\n日志等级: 1 DEBUG / 2 INFO / 3 WARN / 4 ERROR / 5 OFF

[Rule]
DOMAIN,bsbsb.top,{{{空降助手策略}}}
DOMAIN,www.bsbsb.top,{{{空降助手策略}}}
DOMAIN,api.biliapi.com,REJECT,pre-matching,extended-matching
DOMAIN,app.biliapi.com,REJECT,pre-matching,extended-matching
DOMAIN,api.biliapi.net,REJECT,pre-matching,extended-matching
DOMAIN,app.biliapi.net,REJECT,pre-matching,extended-matching
AND,((DOMAIN-SUFFIX,chat.bilibili.com), (OR,((DOMAIN-KEYWORD,stun), (DOMAIN-KEYWORD,tracker), (DOMAIN-KEYWORD,p2p)))),REJECT,pre-matching
{{{屏蔽P2P}}},4480,REJECT-NO-DROP,pre-matching
{{{屏蔽P2P}}},4483,REJECT-NO-DROP,pre-matching
{{{屏蔽P2P}}},9102,REJECT-NO-DROP,pre-matching

[Map Local]
^https:\/\/app\.bilibili\.com\/x\/v2\/splash\/list\? header="content-type: application/json" data-type=text data="{"code":0,"message":"OK","ttl":1,"data":{"max_time":0,"min_interval":31536000,"pull_interval":31536000,"keep_ids":[],"show":[],"list":[{}],"splash_request_id":""}}"
^https:\/\/ap[ip]\.bilibili\.com\/x\/(?:resource\/(?:top\/activity|patch\/tab(?:\/v2)?)|v2\/search\/square|vip\/ads\/materials)\? header="content-type: application/json" data-type=text data="{"code":-404,"message":"-404","ttl":1,"data":null}"
^https:\/\/api\.bilibili\.com\/pgc\/activity\/deliver\/material\/receive\? header="content-type: application/json" data-type=text data="{"code":0,"data":{"closeType":"close_win","container":[],"showTime":""},"message":"success"}"
^https:\/\/api\.live\.bilibili\.com\/xlive\/e-commerce-interface\/v1\/ecommerce-user\/get_shopping_info\? header="content-type: application/json" data-type=text data="{}"
^https:\/\/line3-h5-mobile-api\.biligame\.com\/game\/live\/large_card_material\? header="content-type: application/json" data-type=text data="{"code":0,"message":"success"}"
^https:\/\/grpc\.biliapi\.net\/bilibili\.app\.interface\.v1\.Teenagers\/ModeStatus$ header="content-type: application/grpc|grpc-status: 0" data-type=base64 data="AAAAABMKEQgCEgl0ZWVuYWdlcnMgAioA"
^https:\/\/grpc\.biliapi\.net\/bilibili\.app\.interface\.v1\.Search\/DefaultWords$ header="content-type: application/grpc|grpc-status: 0" data-type=base64 data="AAAAACEaHeaQnOe0ouinhumikeOAgeeVquWJp+aIlnVw5Li7KAE="
^https:\/\/grpc\.biliapi\.net\/bilibili\.app\.(?:view\.v1\.View\/TFInfo|viewunite\.v1\.View\/(?:PlayPause|ViewEndPage))$ header="content-type: application/grpc|grpc-status: 0" data-type=base64 data="AAAAAAA="

[Body Rewrite]
http-response-jq ^https:\/\/api\.live\.bilibili\.com\/xlive\/open-interface\/v2\/tracker\/conf\? '.data.domains=["wss://tracker.chat.bilibili.com"]'
http-response-jq ^https:\/\/api\.bilibili\.com\/x\/pd-proxy\/tracker\? '.data[][]?="stun.chat.bilibili.com:3478"'
http-response-jq ^https:\/\/api\.bilibili\.com\/pgc\/view\/v2\/app\/season\? 'del(.data.payment)'
http-response-jq ^https:\/\/api\.bilibili\.com\/pgc\/page\/channel\? '.data.modules |= map(select(.type != "TIP") | if .type == "BANNER" then .module_data.items |= map(select(.url | startswith("https://www.bilibili.com/blackboard/era/") | not)) else . end)'

[Script]
{{{空降助手}}}.chronos = type=http-response,pattern=^https:\/\/(?:grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.app\.view(?:unite)?\.v1\.View\/ViewProgress$,argument="{"sponsorBlock":"{{{空降助手}}}","sponsorBlockLegacy":"{{{空降助手（旧）}}}","chronosEnabled":"{{{空降资源替换}}}","logLevel":"{{{日志等级}}}"}",requires-body=1,binary-body-mode=1,max-size=1048576,engine=webview,timeout=3,script-path=https://raw.githubusercontent.com/pafekutoburu/Sparkle/refs/heads/master/dist/bilibili.chronos.js?v=11
{{{空降助手（旧）}}}.chronos = type=http-response,pattern=^https:\/\/(?:grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.app\.view(?:unite)?\.v1\.View\/ViewProgress$,argument="{"sponsorBlock":"{{{空降助手}}}","sponsorBlockLegacy":"{{{空降助手（旧）}}}","chronosEnabled":"{{{空降资源替换}}}","logLevel":"{{{日志等级}}}"}",requires-body=1,binary-body-mode=1,max-size=1048576,engine=webview,timeout=3,script-path=https://raw.githubusercontent.com/pafekutoburu/Sparkle/refs/heads/master/dist/bilibili.chronos.js?v=11
{{{空降助手}}}.request = type=http-request,pattern=^https:\/\/(?:grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.community\.service\.dm\.v1\.DM\/DmSegMobile$,argument="{"logLevel":"{{{日志等级}}}"}",requires-body=1,binary-body-mode=1,max-size=65536,engine=jsc,timeout=2,script-path=https://raw.githubusercontent.com/pafekutoburu/Sparkle/refs/heads/master/dist/bilibili.sponsor.request.js?v=11
{{{空降助手}}}.response = type=http-response,pattern=^https:\/\/(?:grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.community\.service\.dm\.v1\.DM\/DmSegMobile$,argument="{"logLevel":"{{{日志等级}}}","server":"{{{空降助手服务器}}}","policy":"{{{空降助手策略}}}","minDuration":"{{{最短片段时长}}}","sponsor":"{{{赞助片段}}}","selfpromo":"{{{自我推广}}}","exclusive_access":"{{{品牌合作}}}","interaction":"{{{三连提醒}}}","poi_highlight":"{{{精彩时刻}}}","intro":"{{{开场动画}}}","outro":"{{{片尾}}}","preview":"{{{回顾概要}}}","padding":"{{{填充内容}}}","filler":"{{{离题闲聊}}}","music_offtopic":"{{{非音乐部分}}}"}",requires-body=1,binary-body-mode=1,max-size=1048576,engine=jsc,timeout=3,script-path=https://raw.githubusercontent.com/pafekutoburu/Sparkle/refs/heads/master/dist/bilibili.sponsor.response.js?v=11
{{{空降助手（旧）}}} = type=http-request,pattern=^https:\/\/(?:grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.community\.service\.dm\.v1\.DM\/DmSegMobile$,argument="{"logLevel":"{{{日志等级}}}"}",requires-body=1,binary-body-mode=1,max-size=-1,engine=webview,timeout=10,script-path=https://raw.githubusercontent.com/pafekutoburu/Sparkle/refs/heads/master/dist/bilibili.protobuf.request.js?v=11
{{{优化评论区加载}}} = type=http-request,pattern=^https:\/\/(?:grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.(?:app\.viewunite\.v1\.View\/View|main\.community\.reply\.v1\.Reply\/MainList)$,argument="{"purifyComment":{{{过滤置顶评论广告}}},"logLevel":"{{{日志等级}}}"}",requires-body=1,binary-body-mode=1,max-size=-1,engine=webview,timeout=10,script-path=https://raw.githubusercontent.com/pafekutoburu/Sparkle/refs/heads/master/dist/bilibili.protobuf.request.js?v=11
bilibili.skin = type=http-response,pattern=^https:\/\/app\.bilibili\.com\/x\/resource\/show\/skin\?,requires-body=1,max-size=1048576,engine=webview,script-path=https://raw.githubusercontent.com/kokoryh/Script/master/js/bili-suit-diy.js
bilibili.live = type=http-response,pattern=^https:\/\/api\.live\.bilibili\.com\/xlive\/(?:app-interface\/v2\/index\/feed|app-room\/v1\/index\/getInfoBy(?:Room|User))\?,requires-body=1,max-size=1048576,engine=webview,script-path=https://raw.githubusercontent.com/pafekutoburu/Sparkle/refs/heads/master/dist/bilibili.json.js
bilibili.json = type=http-response,pattern=^https:\/\/app\.bilibili\.com\/x\/(?:resource\/show\/tab\/v2|v2\/(?:splash\/(?:show|event\/list2)|feed\/index(?:\/story)?|account\/(?:mine(?:\/ipad)?|myinfo)))\?,argument="{"showCreatorHub":{{{创作中心}}}}",requires-body=1,max-size=1048576,engine=webview,script-path=https://raw.githubusercontent.com/pafekutoburu/Sparkle/refs/heads/master/dist/bilibili.json.js
bilibili.webpage = type=http-response,pattern=^https:\/\/www\.bilibili\.com\/blackboard\/era\/.+\.html\?,requires-body=1,max-size=1048576,engine=webview,script-path=https://raw.githubusercontent.com/pafekutoburu/Sparkle/refs/heads/master/dist/webpage.bilibili.js
{{{资料净化}}} = type=http-response,pattern=^https:\/\/(?:grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.(?:app\.(?:show\.v1\.Popular\/Index|dynamic\.v2\.Dynamic\/DynAll|view(?:unite)?\.v1\.View\/(?:View|RelatesFeed|AIRelateAsync)|playurl\.v1\.PlayURL\/PlayView|playerunite\.v1\.Player\/PlayViewUnite)|polymer\.app\.search\.v1\.Search\/SearchAll|main\.community\.reply\.v1\.Reply\/MainList|pgc\.gateway\.player\.v2\.PlayURL\/PlayView)$,argument="{"displayUpList":"{{{动态最常访问}}}","purifyComment":{{{过滤置顶评论广告}}},"sponsorBlock":"{{{空降助手}}}","sponsorBlockLegacy":"{{{空降助手（旧）}}}","logLevel":"{{{日志等级}}}"}",requires-body=1,binary-body-mode=1,max-size=1048576,engine=jsc,timeout=3,script-path=https://raw.githubusercontent.com/pafekutoburu/Sparkle/refs/heads/master/dist/bilibili.protobuf.response.js?v=11

[MITM]
hostname = %APPEND% grpc.biliapi.net, app.bilibili.com, api.bilibili.com, api.live.bilibili.com, www.bilibili.com, line3-h5-mobile-api.biligame.com
